@{
    ViewData["Title"] = "Invoice";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used to style the invoice page -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Invoice container */
    .invoice-box {
        width: 450px;
        margin: 120px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Invoice heading */
        .invoice-box h2 {
            color: #28a745;
            margin-bottom: 15px;
        }

        /* Thank you text */
        .invoice-box p {
            font-size: 16px;
            color: #555;
        }

    /* Back button */
    .back-btn {
        display: inline-block;
        margin-top: 20px;
        background-color: #007bff;
        color: white;
        padding: 10px 16px;
        border-radius: 5px;
        text-decoration: none;
    }

        .back-btn:hover {
            background-color: #0056b3;
        }
</style>

<!-- ================= Invoice Page ================= -->
<div class="invoice-box">

    <!-- Invoice title -->
    <h2>Invoice</h2>

    <!-- Success message -->
    <p>Your order has been placed successfully.</p>
    <p>Thank you for shopping!</p>

    <!-- Back to dashboard link -->
    <a class="back-btn" href="/Customer/Dashboard">
        Back to Dashboard
    </a>
</div>
