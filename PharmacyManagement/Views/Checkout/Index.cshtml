@model List<CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for clean layout and buttons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background */
    body {
        background-color: #f4f6f9;
    }

    /* Checkout container */
    .checkout-box {
        width: 500px;
        margin: 80px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .checkout-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        /* Order list */
        .checkout-box ul {
            list-style: none;
            padding: 0;
        }

            .checkout-box ul li {
                padding: 8px;
                border-bottom: 1px solid #ddd;
            }

    /* Total amount */
    .total-amount {
        text-align: center;
        margin-top: 20px;
        color: #28a745;
    }

    /* Confirm button */
    .confirm-btn {
        width: 100%;
        margin-top: 20px;
    }
</style>

<!-- ================= Checkout Page ================= -->
<div class="checkout-box">

    <!-- Page title -->
    <h2>Checkout</h2>

    @{
        decimal total = 0;
    }

    <!-- Cart items summary -->
    <ul>
        @foreach (var item in Model)
        {
            total += item.Price * item.Quantity;

            <!-- Each cart item -->
            <li>
                @item.MedicineName -
                @item.Quantity × @item.Price
            </li>
        }
    </ul>

    <!-- Total amount -->
    <h3 class="total-amount">
        Total: ৳@total
    </h3>

    <!-- Confirm order form -->
    <form method="post" action="/Checkout/Confirm">
        <button class="btn btn-success confirm-btn" type="submit">
            Confirm Order
        </button>
    </form>

</div>
