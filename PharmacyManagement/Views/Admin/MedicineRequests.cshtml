@model List<MedicineRequest>

@{
    ViewData["Title"] = "Medicine Requests";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for clean table and responsive layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #F54927;
    }

    /* Main container styling */
    .requests-box {
        width: 90%;
        margin: 40px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading style */
        .requests-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    /* Table header background */
    table th {
        background-color: #007bff;
        color: white;
        text-align: left;
    }

    /* Status text style */
    .status-pending {
        color: orange;
        font-weight: bold;
    }

    .status-completed {
        color: green;
        font-weight: bold;
    }
</style>

<!-- ================= Medicine Requests Table ================= -->
<div class="requests-box">

    <!-- Page title -->
    <h2>Medicine Requests</h2>

    <!-- Requests table -->
    <table class="table table-bordered table-hover" cellpadding="6">
        <tr>
            @* <th>Medicine Name</th> *@
            <th>User Id</th>
            <th>Request Date</th>
            <th>Status</th>
        </tr>

        @foreach (var r in Model)
        {
            <tr>
                <!-- Requested medicine name -->
                 <td>@r.MedicineName</td> 

                <!-- Customer user ID -->
                <td>@r.UserId</td>

                <!-- Request date -->
                <td>@r.RequestDate</td>

                <!-- Request status -->
                <td>
                    @if (r.Status == "Pending")
                    {
                        <span class="status-pending">Pending</span>
                    }
                    else
                    {
                        <span class="status-completed">@r.Status</span>
                    }
                </td>
            </tr>
        }
    </table>
</div>
