@{
    ViewData["Title"] = "Request Medicine";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for clean form design -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Request form container */
    .request-box {
        width: 420px;
        margin: 100px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .request-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        /* Submit button full width */
        .request-box button {
            width: 100%;
        }
</style>

<!-- ================= Request Medicine Page ================= -->
<div class="request-box">

    <!-- Page title -->
    <h2>Request Medicine</h2>

    <!-- Request medicine form -->
    <!-- method="post" sends data to CustomerController -->
    <form method="post">

        <!-- Medicine name label -->
        <label class="form-label">Medicine Name</label>

        <!-- Medicine name input -->
        <input class="form-control"
               type="text"
               name="medicineName"
               required />

        <br />

        <!-- Submit request button -->
        <button class="btn btn-primary" type="submit">
            Submit Request
        </button>
    </form>

</div>
