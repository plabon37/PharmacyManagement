@{
    ViewData["Title"] = "Register";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for clean and responsive UI -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Registration form container */
    .register-box {
        width: 380px;
        margin: 100px auto; /* Center horizontally */
        padding: 25px;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Heading style */
        .register-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        /* Full width register button */
        .register-box button {
            width: 100%;
        }

        /* Paragraph text center */
        .register-box p {
            text-align: center;
            margin-top: 15px;
        }
</style>

<!-- ================= Registration Form Container ================= -->
<div class="register-box">

    <!-- Page heading -->
    <h2>Customer Registration</h2>

    <!-- Registration form -->
    <!-- method="post" sends data to AccountController -->
    <form method="post">

        <!-- Full name input -->
        <input class="form-control mb-3"
               name="Name"
               placeholder="Full Name" />

        <!-- Email input -->
        <input class="form-control mb-3"
               name="Email"
               placeholder="Email" />

        <!-- Password input -->
        <input class="form-control mb-3"
               name="Password"
               type="password"
               placeholder="Password" />

        <!-- Submit button -->
        <button class="btn btn-success" type="submit">
            Register
        </button>
    </form>

    <!-- Error message -->
    @if (ViewBag.Error != null)
    {
        <p class="text-danger">
            @ViewBag.Error
        </p>
    }

    <!-- Success message -->
    @if (ViewBag.Success != null)
    {
        <p class="text-success">
            @ViewBag.Success
        </p>
    }
</div>
