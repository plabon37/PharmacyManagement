@{
    ViewData["Title"] = "Login";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used to make the UI clean and responsive -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Set background color for the whole page */
    body {
        background-color: #f4f6f9;
    }

    /* Login box styling */
    .login-box {
        width: 350px;
        margin: 100px auto; /* Centers the box horizontally */
        padding: 25px;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Login heading style */
        .login-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        /* Make the login button full width */
        .login-box button {
            width: 100%;
        }

        /* Center text inside paragraph */
        .login-box p {
            text-align: center;
            margin-top: 15px;
        }
</style>

<!-- ================= Login Form Container ================= -->
<div class="login-box">

    <!-- Page title -->
    <h2>Login</h2>

    <!-- Login form -->
    <!-- method="post" sends data to the controller -->
    <form method="post">

        <!-- Email input field -->
        <!-- form-control is a Bootstrap class for styling -->
        <input class="form-control mb-3"
               name="email"
               placeholder="Email" />

        <!-- Password input field -->
        <input class="form-control mb-3"
               name="password"
               type="password"
               placeholder="Password" />

        <!-- Submit button -->
        <button class="btn btn-primary" type="submit">
            Login
        </button>
    </form>

    <!-- Registration link for new users -->
    <p>
        New Customer?
        <a href="/Account/Register">Register here</a>
    </p>

    <!-- Display error message if login fails -->
    @if (ViewBag.Error != null)
    {
        <p class="text-danger text-center">
            @ViewBag.Error
        </p>
    }
</div>
