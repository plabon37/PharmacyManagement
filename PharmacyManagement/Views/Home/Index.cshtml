@{
    ViewData["Title"] = "Home Page";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for responsive layout and typography -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Home page container */
    .home-box {
        width: 80%;
        margin: 120px auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Main heading style */
        .home-box h1 {
            color: #007bff;
            margin-bottom: 15px;
        }

        /* Paragraph text */
        .home-box p {
            font-size: 16px;
            color: #555;
        }
</style>

<!-- ================= Home Page Content ================= -->
<div class="home-box">

    <!-- Main heading -->
    <h1 class="display-4">Welcome</h1>

    <!-- Information paragraph -->
    <p>
        Learn about
        <a href="https://learn.microsoft.com/aspnet/core">
            building Web apps with ASP.NET Core
        </a>.
    </p>

</div>
