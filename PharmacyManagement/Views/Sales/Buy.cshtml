@{
    ViewData["Title"] = "Buy Medicine";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for responsive table and form styling -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Buy medicine container */
    .buy-box {
        width: 90%;
        margin: 40px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .buy-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    /* Quantity input width */
    .qty-input {
        width: 80px;
        display: inline-block;
    }

    /* Buy button spacing */
    .buy-btn {
        margin-top: 5px;
    }
</style>

<!-- ================= Buy Medicine Page ================= -->
<div class="buy-box">

    <!-- Page title -->
    <h2>Buy Medicine</h2>

    <!-- Medicine list table -->
    <table class="table table-bordered table-hover">
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Available</th>
            <th>Action</th>
        </tr>

        @foreach (var m in Model)
        {
            <tr>
                <!-- Medicine name -->
                <td>@m.Name</td>

                <!-- Medicine price -->
                <td>@m.Price</td>

                <!-- Available quantity -->
                <td>@m.Quantity</td>

                <!-- Buy form -->
                <td>
                    <!-- POST form to submit purchase -->
                    <form method="post">
                        <!-- Hidden medicine ID -->
                        <input type="hidden"
                               name="medicineId"
                               value="@m.MedicineId" />

                        <!-- Quantity input -->
                        <input class="form-control qty-input"
                               type="number"
                               name="quantity"
                               min="1"
                               required />

                        <!-- Buy button -->
                        <button class="btn btn-primary btn-sm buy-btn"
                                type="submit">
                            Buy
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>

</div>
