@model Sale

@{
    ViewData["Title"] = "Invoice";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for clean layout and typography -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Invoice container */
    .invoice-box {
        width: 450px;
        margin: 100px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Invoice heading */
        .invoice-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #28a745;
        }

        /* Invoice detail text */
        .invoice-box p {
            font-size: 16px;
            color: #444;
            margin-bottom: 8px;
        }

    /* Back button */
    .back-btn {
        display: block;
        text-align: center;
        margin-top: 20px;
        background-color: #007bff;
        color: white;
        padding: 10px;
        border-radius: 5px;
        text-decoration: none;
    }

        .back-btn:hover {
            background-color: #0056b3;
        }
</style>

<!-- ================= Invoice Page ================= -->
<div class="invoice-box">

    <!-- Page title -->
    <h2>Invoice</h2>

    <!-- Invoice details -->
    <p><strong>Medicine:</strong> @Model.MedicineName</p>
    <p><strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>Unit Price:</strong> @Model.UnitPrice</p>
    <p><strong>Total Price:</strong> @Model.TotalPrice</p>
    <p><strong>Date:</strong> @Model.SaleDate</p>

    <!-- Back to customer dashboard -->
    <a class="back-btn" href="/Customer/Dashboard">
        Back
    </a>
</div>
