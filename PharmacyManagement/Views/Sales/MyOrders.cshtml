@model List<Sale>

@{
    ViewData["Title"] = "My Orders";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for responsive table and clean UI -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Orders container */
    .orders-box {
        width: 90%;
        margin: 40px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .orders-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    /* Table header style */
    table th {
        background-color: #17a2b8;
        color: white;
        text-align: left;
    }
</style>

<!-- ================= My Orders Page ================= -->
<div class="orders-box">

    <!-- Page title -->
    <h2>My Orders</h2>

    <!-- Orders table -->
    <table class="table table-bordered table-hover">
        <tr>
            <th>Medicine</th>
            <th>Qty</th>
            <th>Total</th>
            <th>Date</th>
        </tr>

        @foreach (var s in Model)
        {
            <tr>
                <!-- Medicine name -->
                <td>@s.MedicineName</td>

                <!-- Quantity -->
                <td>@s.Quantity</td>

                <!-- Total price -->
                <td>@s.TotalPrice</td>

                <!-- Order date -->
                <td>@s.SaleDate</td>
            </tr>
        }
    </table>

</div>
