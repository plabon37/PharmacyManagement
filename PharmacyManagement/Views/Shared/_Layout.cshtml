<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Page encoding and responsive viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Dynamic page title -->
    <title>@ViewData["Title"] - PharmacyManagement</title>

    <!-- Bootstrap core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Project-specific generated styles -->
    <link rel="stylesheet" href="~/PharmacyManagement.styles.css" asp-append-version="true" />

    <!-- ================= Pharmacy Theme Styling ================= -->
    <style>
        /* ===== PAGE BACKGROUND (Soft pharmacy theme colors) ===== */
        body {
            background: radial-gradient(circle at top left, #e0f2fe, transparent 40%), radial-gradient(circle at bottom right, #dcfce7, transparent 40%), linear-gradient(135deg, #f8fbff, #f0f9ff);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* ===== TOP NAVBAR STYLING ===== */
        .navbar {
            background-color: #ffffff !important;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 20px;
            color: #0d6efd !important;
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: #212529 !important;
        }

            /* Navbar hover effect */
            .navbar-nav .nav-link:hover {
                color: #0d6efd !important;
            }

        /* ===== SIDEBAR CONTAINER ===== */
        .bg-light {
            background: linear-gradient(180deg, #ffffff, #eef4ff) !important;
        }

            /* Sidebar small text */
            .bg-light h6 {
                font-size: 13px;
                color: #6c757d;
            }

            /* Sidebar username */
            .bg-light h5 {
                font-weight: 600;
                color: #0d6efd;
            }

        /* ===== SIDEBAR NAVIGATION BUTTONS ===== */
        .nav.flex-column .nav-link {
            background-color: #f1f5ff;
            border: 1px solid #dbe4ff;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 10px;
            color: #0d6efd;
            font-weight: 600;
            text-align: left;
        }

            /* Sidebar hover effect */
            .nav.flex-column .nav-link:hover {
                background-color: #0d6efd;
                color: #ffffff;
            }

            /* Logout button special styling */
            .nav.flex-column .nav-link.text-danger {
                background-color: #fff1f1;
                border-color: #f8d7da;
                color: #dc3545;
            }

                /* Logout hover effect */
                .nav.flex-column .nav-link.text-danger:hover {
                    background-color: #dc3545;
                    color: #ffffff;
                }

        /* ===== MAIN CONTENT AREA ===== */
        .col.p-4 {
            background-color: #ffffff;
            border-radius: 14px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            margin: 15px;
            min-height: 75vh;
        }

        /* ===== FOOTER STYLING ===== */
        footer {
            background-color: #ffffff;
            padding: 14px 0;
            font-size: 14px;
        }

            footer a {
                color: #0d6efd;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }
    </style>
</head>

<body>

    <!-- ================= TOP NAVIGATION BAR ================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <!-- Brand logo / project name -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    PharmacyManagement
                </a>

                <!-- Mobile menu toggle button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Default navbar links removed for cleaner layout -->

            </div>
        </nav>
    </header>

    <!-- ================= SESSION DATA ================= -->
    @{
        // Get logged-in user role and name from session
        var role = Context.Session.GetString("UserRole");
        var name = Context.Session.GetString("UserName");
    }

    <div class="container-fluid">
        <div class="row">

            <!-- ================= LEFT SIDEBAR ================= -->
            @if (role != null)
            {
                <div class="col-md-3 col-lg-2 bg-light min-vh-100 border-end p-3">

                    <!-- Welcome text -->
                    <h6>Welcome</h6>
                    <h5>@name</h5>

                    <hr />

                    <!-- Admin Menu -->
                    @if (role == "Admin")
                    {
                        <ul class="nav flex-column">
                            <li class="nav-item"><a class="nav-link" href="/Admin/Dashboard">🏠 Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Admin/Medicines">💊 Manage Medicines</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Medicine/Index">💊 View Medicines</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Admin/Customers">👥 Customers</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Admin/MedicineRequests">📩 Medicine Requests</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Sales/Index">📊 Sales Report</a></li>
                            <li class="nav-item"><a class="nav-link text-danger" href="/Account/Logout">🚪 Logout</a></li>
                        </ul>
                    }

                    <!-- Customer Menu -->
                    @if (role == "Customer")
                    {
                        <ul class="nav flex-column">
                            <li class="nav-item"><a class="nav-link" href="/Customer/Dashboard">🏠 Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Medicine/Index">💊 View Medicines</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Cart/Index">🛒 My Cart</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Customer/Orders">📦 My Orders</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Customer/RequestMedicine">📝 Request Medicine</a></li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Customer/Messages">
                                    🔔 Notifications
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link text-danger" href="/Account/Logout">🚪 Logout</a></li>
                        </ul>
                    }
                </div>
            }

            <!-- ================= MAIN PAGE CONTENT ================= -->
            <div class="col p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="border-top text-muted mt-4">
        <div class="container text-center">
            &copy; 2025 - PharmacyManagement -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- ================= JAVASCRIPT FILES ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Optional page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
