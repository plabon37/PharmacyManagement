<!-- ================= jQuery Validation ================= -->
<!-- This script enables client-side form validation -->
<!-- It validates inputs like required fields, email format, etc. -->
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

<!-- ================= Unobtrusive Validation ================= -->
<!-- This script connects ASP.NET MVC validation attributes
     (like [Required], [EmailAddress]) with jQuery validation -->
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
