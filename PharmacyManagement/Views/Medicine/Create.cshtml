@model Medicine

@{
    ViewData["Title"] = "Add Medicine";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for form styling and layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background color */
    body {
        background-color: #f4f6f9;
    }

    /* Add medicine form container */
    .medicine-form-box {
        width: 420px;
        margin: 100px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .medicine-form-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        /* Save button full width */
        .medicine-form-box button {
            width: 100%;
        }
</style>

<!-- ================= Add Medicine Page ================= -->
<div class="medicine-form-box">

    <!-- Page title -->
    <h2>Add Medicine</h2>

    <!-- Add medicine form -->
    <!-- method="post" sends data to MedicineController -->
    <form method="post">

        <!-- Medicine name input -->
        <label class="form-label">Name</label>
        <input class="form-control"
               type="text"
               name="Name"
               required />

        <br />

        <!-- Medicine price input -->
        <label class="form-label">Price</label>
        <input class="form-control"
               type="number"
               name="Price"
               step="0.01"
               required />

        <br />

        <!-- Medicine quantity input -->
        <label class="form-label">Quantity</label>
        <input class="form-control"
               type="number"
               name="Quantity"
               required />

        <br />

        <!-- Submit button -->
        <button class="btn btn-success" type="submit">
            Save
        </button>
    </form>

</div>
