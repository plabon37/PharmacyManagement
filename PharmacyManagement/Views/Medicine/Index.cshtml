@model List<Medicine>

@{
    ViewData["Title"] = "Available Medicines";
}

<!-- ================= Bootstrap CDN ================= -->
<!-- Bootstrap is used for responsive table and button styling -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= Custom CSS ================= -->
<style>
    /* Page background */
    body {
        background-color: #f4f6f9;
    }

    /* Medicine list container */
    .medicine-list-box {
        width: 90%;
        margin: 40px auto;
        background: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Page heading */
        .medicine-list-box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

    /* Table header style */
    table th {
        background-color: #17a2b8;
        color: white;
        text-align: left;
    }

    /* Add to cart button */
    .cart-btn {
        background-color: #28a745;
        color: white;
        padding: 6px 10px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
    }

        .cart-btn:hover {
            background-color: #218838;
        }

    /* Out of stock text */
    .out-stock {
        color: red;
        font-weight: bold;
    }
</style>

<!-- ================= Available Medicines Page ================= -->
<div class="medicine-list-box">

    <!-- Page title -->
    <h2>Available Medicines</h2>

    <!-- Medicines table -->
    <table class="table table-bordered table-hover" cellpadding="6">
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>

            <!-- Action column only visible for Customer -->
            @if (Context.Session.GetString("UserRole") == "Customer")
            {
                <th>Action</th>
            }
        </tr>

        @foreach (var m in Model)
        {
            <tr>
                <!-- Medicine name -->
                <td>@m.Name</td>

                <!-- Medicine price -->
                <td>@m.Price</td>

                <!-- Available stock -->
                <td>@m.Quantity</td>

                <!-- Customer-only action column -->
                @if (Context.Session.GetString("UserRole") == "Customer")
                {
                    <td>
                        @if (m.Quantity > 0)
                        {
                            <!-- Add to cart button -->
                            <a class="cart-btn"
                               href="/Cart/Add/@m.MedicineId">
                                🛒 Add to Cart
                            </a>
                        }
                        else
                        {
                            <!-- Out of stock message -->
                            <span class="out-stock">
                                Out of Stock
                            </span>
                        }
                    </td>
                }
            </tr>
        }
    </table>

</div>
